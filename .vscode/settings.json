{
  // Use the uv-managed virtual environment
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/bin/python",
  // Enable linting with Ruff
  "ruff.enable": true,
  "ruff.importStrategy": "fromEnvironment",
  "ruff.lint.enable": true,
  // Format on save using Black
  "editor.formatOnSave": true,
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  // Format on save using Biome for JS/TS
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.indentSize": "tabSize"
  },
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
    "editor.indentSize": "tabSize"
  },
  // Format on save using Biome for JSX/TSX
  "[javascriptreact]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.indentSize": "tabSize"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.indentSize": "tabSize"
  },
  // Test discovery and running
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": [
    "tests"
  ],
  // Optional: auto organize imports and trim whitespace
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  }
}